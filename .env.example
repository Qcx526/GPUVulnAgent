# =============================================================================
# GPUVulnAgent — environment template
# Copy to .env in the project root and fill in what you have.
# .env is git-ignored; secrets must never be committed, logged or written to
# evidence. The agent redacts key-shaped strings before anything reaches disk.
# =============================================================================

# --- LLM provider (DeepSeek, OpenAI-compatible endpoint) --------------------
DEEPSEEK_API_KEY=
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=8192
LLM_TIMEOUT=300
LLM_MAX_ATTEMPTS=3

# --- web search provider ---------------------------------------------------
TAVILY_API_KEY=

# --- paths (relative paths resolve against the project root) ---------------
TOOLCHAIN_ROOT=toolchains
RESEARCH_DATA_ROOT=research_archive
ARTIFACT_ROOT=.local/artifacts

# --- runtime limits --------------------------------------------------------
AGENT_MAX_TURNS=12
AGENT_RUN_TIMEOUT=900
SHELL_TIMEOUT=300

# --- Linux GPU execution backend (WSL2 + Docker) ---------------------------
# The agent runs on Windows; Linux work happens in WSL2. These must match the
# distro/user that owns the Docker Engine. No host driver is installed in WSL.
GPU_BACKEND_ENABLED=1
WSL_DISTRO=Ubuntu-22.04
WSL_USER=pocdev
WSL_WORKER_ROOT=/home/pocdev/gpuvulnagent-worker
GPU_IMAGE=nvidia/cuda:12.8.0-devel-ubuntu22.04
WSL_CALL_TIMEOUT=300
