 "executions": [
  {
   "argv": [
    "bash",
    "-lc",
    "set -x; mkdir -p t1; nvcc -O2 -arch=sm_75 va_vec4.cu -o t1/va_vec4; echo VEC4_BUILD_RC=$?; nvcc -O2 -arch=sm_75 -cubin va_vec4.cu -o t1/va_vec4.cubin; nvcc -O2 -arch=sm_75 -ptx va_vec4.cu -o t1/va_vec4.ptx; nvcc -O2 -arch=sm_75 va_broken.cu -o t1/va_broken; echo BROKEN_BUILD_RC=$?; nvcc -O2 -arch=sm_75 -cubin va_broken.cu -o t1/va_broken.cubin; sha256sum t1/va_vec4 t1/va_vec4.cubin t1/va_vec4.ptx t1/va_broken t1/va_broken.cubin | tee t1/hashes_variants.txt; ./t1/va_vec4 > t1/run_vec4.log 2>&1; echo VEC4_RUN_EXIT=$? | tee -a t1/run_vec4.log; ./t1/va_broken > t1/run_broken.log 2>&1; echo BROKEN_RUN_EXIT=$? | tee -a t1/run_broken.log; echo '===== vec4 ====='; cat t1/run_vec4.log; echo '===== broken ====='; cat t1/run_broken.log; /usr/local/cuda/bin/nvdisasm -c t1/va_vec4.cubin > t1/va_vec4.sass 2>&1; echo DISASM_RC=$?; wc -l t1/va_vec4.sass; grep -n -A40 'vector_add_vec4' t1/va_vec4.sass | head -60"
   ],
